\n            torch.tensor(\n\n                image,\n\n                dtype=torch.float32\n\n            ),\n\n            torch.tensor(\n\n                mask,\n\n                dtype=torch.float32\n\n            )\n\n        )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-08T08:32:42.899323Z","iopub.execute_input":"2026-06-08T08:32:42.899591Z","iopub.status.idle":"2026-06-08T08:32:42.913235Z","shell.execute_reply.started":"2026-06-08T08:32:42.899557Z","shell.execute_reply":"2026-06-08T08:32:42.91243Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"dataset = DINOv2Dataset(\n    ROOT_DIR\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-08T08:32:42.914089Z","iopub.execute_input":"2026-06-08T08:32:42.914355Z","iopub.status.idle":"2026-06-08T08:32:43.811604Z","shell.execute_reply.started":"2026-06-08T08:32:42.914325Z","shell.execute_reply":"2026-06-08T08:32:43.81099Z"}},"outputs":[{"name":"stdout","text":"Total Samples: 4655\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"train_size = int(\n    0.70 * len(dataset)\n)\n\nval_size = int(\n    0.15 * len(dataset)\n)\n\ntest_size = (\n\n    len(dataset)\n\n    -\n\n    train_size\n\n    -\n\n    val_size\n\n)\n\ntrain_dataset, val_dataset, test_dataset = random_split(\n\n    dataset,\n\n    [\n\n        train_size,\n\n        val_size,\n\n        test_size\n\n    ]\n\n)\n\nprint(\n\n    \"Train:\",\n\n    len(train_dataset)\n\n)\n\nprint(\n\n    \"Validation:\",\n\n    len(val_dataset)\n\n)\n\nprint(\n\n    \"Test:\",\n\n    len(test_dataset)\n\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-08T08:32:43.812747Z","iopub.execute_input":"2026-06-08T08:32:43.813079Z","iopub.status.idle":"2026-06-08T08:32:43.834127Z","shell.execute_reply.started":"2026-06-08T08:32:43.813055Z","shell.execute_reply":"2026-06-08T08:32:43.833469Z"}},"outputs":[{"name":"stdout","text":"Train: 3258\nValidation: 698\nTest: 69