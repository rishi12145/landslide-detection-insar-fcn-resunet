    "import numpy as np\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"HEATMAP GENERATOR\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "heatmap_folder = \"/kaggle/working/heatmaps\"\n",
