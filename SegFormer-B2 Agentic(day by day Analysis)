    "# define the hybrid loss function combining BCE loss and Dice loss\n",
    "def hybrid_loss(\n",
    "\n",
    "    pred,\n",
    "\n",
    "    target\n",
    "\n",
    "):\n",
    "\n",
    "    # compute binary cross entropy loss\n",
    "    bce = bce_loss(\n",
    "\n",
    "        pred,\n",
    "\n",
    "        target\n",
    "\n",
    "    )\n",
    "\n",
    "    # compute Dice loss\n",
    "    dice = dice_loss(\n",
    "\n",
    "        pred,\n",
    "\n",
    "        target\n",
    "\n",
    "    )\n",
    "\n",
    "    # combine BCE loss and Dice loss using their respective weights\n",
    "    total_loss = (\n",
    "\n",
    "        bce_weight * bce\n",
    "\n",
    "        +\n",
    "\n",
    "        dice_weight * dice\n",
    "\n",
    "    )\n",
    "\n",
    "    # return the final hybrid loss\n",
    "    return total_loss"
   ]
