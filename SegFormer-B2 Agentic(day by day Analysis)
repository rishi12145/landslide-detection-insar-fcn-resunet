    "            )\n",
    "\n",
    "            recall = TP / (\n",
    "                TP + FN + 1e-8\n",
    "            )\n",
    "\n",
    "            specificity = TN / (\n",
    "                TN + FP + 1e-8\n",
    "            )\n",
    "\n",
    "            sensitivity = recall\n",
    "\n",
    "            accuracy = (\n",
