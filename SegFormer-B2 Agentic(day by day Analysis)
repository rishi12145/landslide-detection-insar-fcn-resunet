al == \"12days\"\n\n        ):\n\n            files_12.add(\n                filename\n            )\n\n        elif (\n\n            reg == region\n\n            and\n\n            temporal == \"18days\"\n\n        ):\n\n            files_18.add(\n                filename\n            )\n\n    common = sorted(\n\n        files_6\n\n        &\n\n        files_12\n\n        &\n\n        files_18\n\n    )\n\n    common_samples[region] = common\n\n    print(\"\\n\")\n\n    print(\"=\" * 70)\n\n    print(\n        f\"Region : {region}\"\n    )\n\n    print(\"=\" * 70)\n\n    print(\n        \"6 Days Samples :\",\n        len(files_6)\n    )\n\n    print(\n        \"12 Days Samples:\",\n        len(files_12)\n    )\n\n    print(\n        \"18 Days Samples:\",\n        len(files_18)\n    )\n\n    print(\n        \"Common Samples :\",\n        len(common)\n    )\n\n    if len(common) > 0:\n\n        print(\n            \"Example Sample:\",\n            common[0]\n        )\n\nprint(\"\\n\")\n\nprint(\"=\" * 70)\n\nprint(\n    \"COMMON SAMPLE SEARCH COMPLETED\"\n)\n\nprint(\"=\" * 70)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-23T09:44:54.242594Z","iopub.execute_input":"2026-06-23T09:44:54.245079Z","iopub.status.idle":"2026-06-23T09:44:54.305248Z","shell.execute_reply.started":"2026-06-23T09:44:54.245037Z","shell.execute_reply":"2026-06-23T09:44:54.304627Z"}},"outputs":[{"name":"stdout","text":"Total Samples: 13230\n\n\n======================================================================\nRegion : EcrinPark\n======================================================================\n6 Days Samples : 35\n12 Days Samples: 35\n18 Days Samples: 35\nCommon Samples : 35\nExample Sample: 106_23.tif\n\n\n======================================================================\nRegion : OutsideTheBox\n======================================================================\n6 Days Samples : 84\n12 Days Samples: 84\n18 Days Samples: 84\nCommon Samples : 84\nExamp