    "\n",
    "        # ----------------------------------\n",
    "        # Process Each Image\n",
    "        # ----------------------------------\n",
    "\n",
    "        for b in range(batch_size):\n",
    "\n",
    "            # ----------------------------------\n",
    "            # Extract Single Sample\n",
    "            # ----------------------------------\n",
    "\n",
    "            pred = predictions[b, 0].cpu().numpy()\n",
    "\n",
    "            gt = masks[b, 0].cpu().numpy()\n",
    "\n",
    "            prob = probabilities[b, 0].cpu().numpy()\n",
    "\n",
