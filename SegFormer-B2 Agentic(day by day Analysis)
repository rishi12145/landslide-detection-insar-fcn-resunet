    "# ==========================================================\n",
    "# CELL G : Confidence Analysis + Severity Assessment\n",
    "# ==========================================================\n",
    "\n",
    "import numpy as np\n",
    "import json\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"CONFIDENCE & SEVERITY ANALYSIS MODULE\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "for metadata in metadata_list:\n",
    "\n",
    "    # =====================================================\n",
