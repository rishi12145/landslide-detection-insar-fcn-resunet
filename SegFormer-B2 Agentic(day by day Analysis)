    "                (gt == 1)\n",
    "            )\n",
    "\n",
    "            TN = np.sum(\n",
    "                (pred == 0) &\n",
    "                (gt == 0)\n",
    "            )\n",
    "\n",
    "            # ----------------------------------\n",
