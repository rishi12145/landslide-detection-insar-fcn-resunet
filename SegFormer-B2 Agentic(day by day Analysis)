    "for metadata in metadata_list:\n",
    "\n",
    "    # ------------------------------------\n",
    "    # Load Probability Map\n",
    "    # ------------------------------------\n",
    "\n",
    "    probability = metadata[\"probability_map\"]\n",
    "\n",
    "    # Normalize to 0-255\n",
    "    probability = np.clip(\n",
    "        probability,\n",
    "        0,\n",
    "        1\n",
    "    )\n",
    "\n",
    "    probability = (\n",
    "        probability * 255\n",
    "    ).astype(np.uint8)\n",
    "\n",
    "    # ------------------------------------\n",
    "    # Apply Heatmap\n",
    "    # ------------------------------------\n",
    "\n",
    "    heatmap = cv2.applyColorMap(\n",
    "\n",
    "        probability,\n",
    "\n",
    "        cv2.COLORMAP_JET\n",
    "\n",
    "    )\n",
    "\n",
    "    # ------------------------------------\n",
    "    # Save Heatmap\n",
    "    # ------------------------------------\n",
    "\n",
